# Direct Python dependencies of the public reproducibility package (Python 3.13).
# requirements-lock.txt pins every transitive dependency with hashes:
#   pip-compile --generate-hashes --allow-unsafe -o requirements-lock.txt requirements.in
#   pip install --require-hashes -r requirements-lock.txt
